<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="4dp"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp"> <!-- 제목과 내용 사이 간격 줄임 -->

        <!-- 1. 물음표 버튼 -->
        <ImageButton
            android:id="@+id/btn_help"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_help"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Help"
            android:layout_marginEnd="8dp"
            android:alpha="0.6"/>

        <!-- 2. 제목 -->
        <TextView
            android:id="@+id/tv_param_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Parameter Title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSecondary"/>
    </LinearLayout>

    <!-- 값 표시 및 컨트롤 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 현재 값 표시 -->
        <TextView
            android:id="@+id/tv_param_value"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="100"
            android:gravity="center_vertical"

            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="15sp"
            app:autoSizeMaxTextSize="30sp"
            app:autoSizeStepGranularity="1sp"

            android:textStyle="bold"
            android:textColor="?attr/colorOnSecondary"
            android:layout_marginStart="30dp"
            android:paddingEnd="10dp"/>

        <!-- 컨트롤 영역을 오른쪽 끝으로 정렬하기 위한 프레임 -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- 타입 1: 숫자형 (INT, FLOAT) 컨트롤 -->
            <LinearLayout
                android:id="@+id/layout_numeric_control"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_minus"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="-"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="#FFA270"/>

                <Button
                    android:id="@+id/btn_plus"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="+"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#4CAF50"/>
            </LinearLayout>

            <!-- 타입 2: 불리언 (BOOL) 컨트롤 -->
            <!-- 너비를 위 숫자 버튼들의 합(56+56+8 = 120dp)과 맞춤 -->
            <Button
                android:id="@+id/btn_toggle"
                android:layout_width="115dp"
                android:layout_height="48dp"
                android:text="ON"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="#2196F3"
                android:visibility="gone"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <!-- 타입 3: 기타 수정 버튼 -->
            <Button
                android:id="@+id/btn_edit"
                android:layout_width="120dp"
                android:layout_height="56dp"
                android:text="Edit"
                android:textSize="16sp"
                android:visibility="gone"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </FrameLayout>
    </LinearLayout>

    <!-- 구분선 (선택사항, 필요 없다면 제거 가능) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp"/>

</LinearLayout>
