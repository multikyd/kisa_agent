<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:paddingTop="22dp"> <!-- ★ 화면 전체 상단 여백 추가 (상태 표시줄 겹침 방지) -->

    <!-- 상단 커스텀 타이틀 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="11dp"
        android:paddingBottom="10dp"
        android:background="#1A1A1A">

        <!-- 제목 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tmux Log Viewer"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- 체크박스 -->
        <CheckBox
            android:id="@+id/cb_auto_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto Update"
            android:textColor="#CCCCCC"
            android:buttonTint="#4CAF50"
            android:checked="true"
            android:minHeight="0dp"
            android:minWidth="0dp"/>
    </LinearLayout>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"/>

    <!-- 로그 스크롤 영역 -->
    <!-- 좌우 패딩을 8dp로 통일하여 균형을 맞춤 -->
    <ScrollView
        android:id="@+id/scroll_view_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tv_full_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:textColorHighlight="#50FFFFFF"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:lineSpacingExtra="0dp"

            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:textIsSelectable="true"

            android:text="Loading..." />

    </ScrollView>

</LinearLayout>
